{
  "name": "thymeleaf-language-support",
  "displayName": "Thymeleaf Language Support",
  "description": "Thymeleaf syntax highlighting, expression parser diagnostics, Spring controller model validation, completion, hover, navigation, and fragment tooling for HTML templates in VSCode",
  "publisher": "JUNGHO",
  "icon": "logo.png",
  "galleryBanner": {
    "color": "#005F0F",
    "theme": "dark"
  },
  "license": "Apache-2.0",
  "main": "./out/extension.js",
  "version": "1.1.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/jungho-dev/thymeleaf-language-support.git"
  },
  "homepage": "https://github.com/jungho-dev/thymeleaf-language-support#readme",
  "bugs": {
    "url": "https://github.com/jungho-dev/thymeleaf-language-support/issues"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Snippets",
    "Other"
  ],
  "keywords": [
    "thymeleaf",
    "spring",
    "spring-boot",
    "template",
    "html",
    "syntax",
    "diagnostics"
  ],
  "activationEvents": [
    "onLanguage:html",
    "onLanguage:java"
  ],
  "contributes": {
    "outputChannels": [
      "Thymeleaf-Language-Support"
    ],
    "grammars": [
      {
        "scopeName": "thymeleaf.injection",
        "path": "./syntaxes/thymeleaf.injection.tmLanguage.json",
        "injectTo": [
          "text.html.basic",
          "text.html.derivative"
        ]
      }
    ],
    "snippets": [
      {
        "language": "html",
        "path": "./snippets/thymeleaf.json"
      }
    ],
    "commands": [
      {
        "command": "Thymeleaf-Language-Support.validate",
        "title": "Validate Current Template",
        "category": "Thymeleaf-Language-Support",
        "icon": "$(check)"
      },
      {
        "command": "Thymeleaf-Language-Support.gotoFragment",
        "title": "Go to Fragment Template",
        "category": "Thymeleaf-Language-Support",
        "icon": "$(references)"
      },
      {
        "command": "Thymeleaf-Language-Support.rebuildIndex",
        "title": "Rebuild Template, Controller, and Message Index",
        "category": "Thymeleaf-Language-Support",
        "icon": "$(refresh)"
      },
      {
        "command": "Thymeleaf-Language-Support.openLogOutput",
        "title": "Open Log Output",
        "category": "Thymeleaf-Language-Support"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "Thymeleaf-Language-Support.gotoFragment",
          "when": "resourceLangId == html",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "Thymeleaf-Language-Support.openTemplate",
          "when": "false"
        },
        {
          "command": "Thymeleaf-Language-Support.showAttributeUsages",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Thymeleaf-Language-Support",
      "properties": {
        "Thymeleaf-Language-Support.logLevel": {
          "type": "string",
          "scope": "window",
          "enum": [
            "off",
            "debug",
            "info",
            "hint",
            "warn",
            "error"
          ],
          "default": "info"
        },
        "Thymeleaf-Language-Support.diagnosticsEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Thymeleaf template diagnostics (expression syntax, attribute validation, model and fragment references)"
        },
        "Thymeleaf-Language-Support.disabledDiagnosticCodes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "thymeleaf-unclosed-expression",
              "thymeleaf-unclosed-string",
              "thymeleaf-unexpected-closing",
              "thymeleaf-mismatched-bracket",
              "thymeleaf-empty-expression",
              "thymeleaf-nested-expression",
              "thymeleaf-unclosed-literal-substitution",
              "thymeleaf-invalid-message-key",
              "thymeleaf-expression-syntax",
              "thymeleaf-missing-value",
              "thymeleaf-empty-value",
              "thymeleaf-unknown-attribute",
              "thymeleaf-deprecated-attribute",
              "thymeleaf-duplicate-attribute",
              "thymeleaf-invalid-each",
              "thymeleaf-invalid-inline",
              "thymeleaf-invalid-fragment",
              "thymeleaf-invalid-remove",
              "thymeleaf-invalid-assignation",
              "thymeleaf-object-expression",
              "thymeleaf-unescaped-text",
              "thymeleaf-unclosed-inline",
              "thymeleaf-link-path-variable",
              "thymeleaf-unknown-template",
              "thymeleaf-unknown-fragment",
              "thymeleaf-fragment-arity",
              "thymeleaf-unknown-model-attribute",
              "thymeleaf-unknown-property",
              "thymeleaf-selection-without-object",
              "thymeleaf-unknown-message-key",
              "thymeleaf-message-arity",
              "thymeleaf-unknown-link",
              "thymeleaf-missing-view"
            ]
          },
          "default": [],
          "description": "Diagnostic codes to suppress while diagnostics remain enabled"
        },
        "Thymeleaf-Language-Support.languageFeaturesEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable completion, hover, go-to-definition, references, signature help, document links, and fragment symbols"
        },
        "Thymeleaf-Language-Support.javaEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Index Spring controllers and classes to validate model attributes and properties, and to provide Java-side CodeLens and navigation"
        },
        "Thymeleaf-Language-Support.modelValidationEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Report ${...} roots that no mapped controller adds and properties that do not exist on the inferred Java type"
        },
        "Thymeleaf-Language-Support.linkValidationEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Report @{...} paths that match neither a controller mapping nor a static resource"
        },
        "Thymeleaf-Language-Support.messageValidationEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Report #{...} keys missing from the indexed message bundles and argument count mismatches"
        },
        "Thymeleaf-Language-Support.codeLensEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Show CodeLens on controller view names and model attributes"
        },
        "Thymeleaf-Language-Support.additionalAttributes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra th:* attribute names accepted without an unknown-attribute diagnostic (custom dialect processors)"
        },
        "Thymeleaf-Language-Support.templateGlobs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/templates/**"
          ],
          "description": "Glob prefixes under which fragment template names are resolved (Thymeleaf template resolver prefix)"
        },
        "Thymeleaf-Language-Support.javaGlobs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/src/main/java/**/*.java"
          ],
          "description": "Glob patterns of Java sources to index for controllers, model attributes, and types"
        },
        "Thymeleaf-Language-Support.messageGlobs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/src/main/resources/**/messages*.properties",
            "**/src/main/resources/i18n/**/*.properties"
          ],
          "description": "Glob patterns of message bundles used for #{...} validation and completion"
        },
        "Thymeleaf-Language-Support.staticGlobs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/src/main/resources/static/**",
            "**/src/main/resources/public/**",
            "**/src/main/resources/resources/**",
            "**/src/main/resources/META-INF/resources/**"
          ],
          "description": "Glob patterns of static resource roots used for @{...} validation and completion"
        },
        "Thymeleaf-Language-Support.searchExclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/target/**",
            "**/build/**",
            "**/bin/**",
            "**/out/**",
            "**/dist/**",
            "**/.git/**"
          ],
          "description": "Glob patterns excluded from template, Java, message, and static resource scanning"
        },
        "Thymeleaf-Language-Support.maxDocumentLength": {
          "type": "number",
          "default": 300000,
          "minimum": 0,
          "description": "Skip diagnostics above this document length. Use 0 for no limit."
        }
      }
    }
  },
  "engines": {
    "vscode": ">=1.116.0",
    "node": ">=21.0.0",
    "npm": ">=10.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "bundle": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --target=node21 --minify",
    "compile": "bun run typecheck && bun run bundle",
    "compile:e2e": "tsc -p tsconfig.test.json",
    "test": "bun test",
    "test:e2e": "bun run compile && bun run compile:e2e && node ./out-test/runTest.js",
    "package": "bun run compile && vsce package --no-dependencies",
    "git": "bun run ~/.bootstrap/bootstrap-sync.ts --git",
    "swc": "bun run ~/.bootstrap/bootstrap-sync.ts --swc",
    "sync": "bun run ~/.bootstrap/bootstrap-sync.ts --sync",
    "tools": "bun run ~/.bootstrap/bootstrap-sync.ts --tools"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.2",
    "@swc/helpers": "^0.5.23",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.5.0",
    "@types/vscode": "1.116.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "mocha": "^12.0.0",
    "ts-morph": "^28.0.0",
    "ts-prune": "^0.10.3",
    "tsc-alias": "^1.9.4",
    "typescript": "^7.0.2",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
