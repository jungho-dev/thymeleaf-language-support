{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Thymeleaf-Language-Support Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}/src/test/fixtures/workspace"
      ],
      "outFiles": [
        "${workspaceFolder}/out/**/*.js"
      ],
      "preLaunchTask": "compile"
    }
  ]
}
